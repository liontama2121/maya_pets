# MAYA Pets - variables de entorno
# Copiar a `.env` (raíz del proyecto). `.env` nunca se sube a git.

# --- Cloudflare (D1 remota + R2) ---
# ID de la cuenta: dashboard de Cloudflare > Workers & Pages > columna derecha.
CLOUDFLARE_ACCOUNT_ID=
# Token de API con permisos: D1 Edit, Workers R2 Storage Edit, Workers Scripts Edit.
CLOUDFLARE_API_TOKEN=

# --- Panel admin (Cloudflare Access) ---
# Dominio del equipo Zero Trust, p. ej. mayapets.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" de la aplicación de Access que protege /admin.
ACCESS_AUD=
# Solo desarrollo en localhost: correo con el que entras al panel sin Access.
# Debe existir en la tabla staff_users. Nunca se usa fuera de localhost.
DEV_ADMIN_EMAIL=luisa@mayapets.co
