# MAYA Pets - variables de entorno
# Copiar a `.env` (raíz del proyecto). `.env` nunca se sube a git.

# --- Cloudflare (D1 remota + R2) ---
# ID de la cuenta: dashboard de Cloudflare > Workers & Pages > columna derecha.
CLOUDFLARE_ACCOUNT_ID=
# Token de API con permisos: D1 Edit, Workers R2 Storage Edit, Workers Scripts Edit.
CLOUDFLARE_API_TOKEN=

# --- Panel admin ---
# El usuario y la contraseña del panel NO van aquí: en local van en apps/web/.dev.vars
# y en producción como secretos en Cloudflare (ADMIN_USERNAME, ADMIN_PASSWORD, SESSION_SECRET, ADMIN_NAME).
