# Copiar a .dev.vars (solo desarrollo local).
# Usuario y contraseña del panel /admin. En producción se configuran como secretos en Cloudflare.
ADMIN_USERNAME=luisa
ADMIN_PASSWORD=cambia-esta-contrasena
# Texto al azar de al menos 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ADMIN_NAME=Luisa
