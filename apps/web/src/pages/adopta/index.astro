---
import { adoption } from "@maya/api";
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { DogCard } from "../../components/shared/DogCard";
import MayaGuide from "../../islands/site/MayaGuide";
import Site from "../../layouts/Site.astro";
import { envOf } from "../../lib/server";

const { DB } = envOf(Astro);
const q = Astro.url.searchParams;
const filters = { size: q.get("tamano") ?? "", age: q.get("edad") ?? "", energy: q.get("energia") ?? "" };
const [all, shown, adopted] = await Promise.all([
  adoption.listDogs(DB),
  adoption.listDogs(DB, filters),
  adoption.adoptedDogs(DB, 6),
]);
const available = all.filter((d) => d.status === "disponible");

const link = (k: string, v: string) => {
  const p = new URLSearchParams(q);
  if (v) p.set(k, v);
  else p.delete(k);
  const s = p.toString();
  return s ? `/adopta?${s}#perritos` : "/adopta#perritos";
};
const groups = [
  { key: "tamano", label: "Tamaño", current: filters.size, options: Object.entries(adoption.SIZE_LABEL) },
  { key: "edad", label: "Edad", current: filters.age, options: Object.entries(adoption.AGE_GROUPS).map(([k, v]) => [k, v.label.split(" (")[0]!]) },
  { key: "energia", label: "Energía", current: filters.energy, options: Object.entries(adoption.ENERGY_LABEL) },
];
---

<Site
  title="Adopta con Maya: perritos en adopción en Bogotá"
  description="Perritos en adopción en Bogotá, vacunados y esterilizados. Maya te ayuda a encontrar el que encaja con tu hogar."
>
  <section class="on-accent bg-sun-400 text-teal-900">
    <div class="mx-auto grid max-w-[1280px] gap-8 px-4 py-12 sm:px-6 md:grid-cols-[1.2fr_1fr] md:items-center md:py-16">
      <div>
        <h1 class="text-5xl font-bold leading-[1.02] [font-variation-settings:'wght'_780] sm:text-6xl">Adopta con Maya</h1>
        <p class="mt-4 max-w-[46ch] text-xl">
          Maya es una perrita imaginaria. Ellos son muy reales y esperan una familia. Respóndele cuatro preguntas y te dice quién
          encaja contigo.
        </p>
        <p class="mt-4 font-semibold">
          {available.length} {available.length === 1 ? "perrito disponible" : "perritos disponibles"} ahora mismo
        </p>
      </div>
      <ol class="space-y-3" aria-label="Cómo funciona">
        <li class="flex gap-4 rounded-[var(--radius-toy)] bg-white/70 p-4">
          <PawPrint weight="fill" size={26} className="shrink-0 text-teal-700" aria-hidden="true" />
          <span><strong>Conócelos</strong> y elige con la ayuda de Maya.</span>
        </li>
        <li class="flex gap-4 rounded-[var(--radius-toy)] bg-white/70 p-4">
          <PawPrint weight="fill" size={26} className="shrink-0 rotate-12 text-teal-700" aria-hidden="true" />
          <span><strong>Envía tu solicitud</strong>: te escribimos por WhatsApp.</span>
        </li>
        <li class="flex gap-4 rounded-[var(--radius-toy)] bg-white/70 p-4">
          <PawPrint weight="fill" size={26} className="shrink-0 -rotate-12 text-teal-700" aria-hidden="true" />
          <span><strong>Se conocen</strong> y, si hay química, empieza la vida juntos.</span>
        </li>
      </ol>
    </div>
  </section>

  <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6">
    <MayaGuide client:visible dogs={all} />

    <section id="perritos" class="mt-16 scroll-mt-24" aria-labelledby="titulo-perritos">
      <h2 id="titulo-perritos" class="text-3xl font-bold [font-variation-settings:'wght'_720]">Todos los perritos</h2>
      <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:gap-8">
        {
          groups.map((g) => (
            <nav aria-label={`Filtrar por ${g.label.toLowerCase()}`} class="flex flex-wrap items-center gap-2">
              <span class="mr-1 font-semibold">{g.label}:</span>
              <a href={link(g.key, "")} class="chip !min-h-10 text-sm" aria-current={!g.current ? "page" : undefined}>
                Todos
              </a>
              {g.options.map(([v, l]) => (
                <a href={link(g.key, v)} class="chip !min-h-10 text-sm" aria-current={g.current === v ? "page" : undefined}>
                  {l}
                </a>
              ))}
            </nav>
          ))
        }
      </div>
      {
        shown.length === 0 ? (
          <div class="mt-8 rounded-[var(--radius-toy)] bg-white p-8 text-center">
            <PawPrint weight="fill" size={44} className="mx-auto text-teal-400" aria-hidden="true" />
            <p class="mt-3 text-lg font-semibold">Ningún perrito coincide con esos filtros.</p>
            <a href="/adopta#perritos" class="btn btn-soft mt-4">
              Ver todos
            </a>
          </div>
        ) : (
          <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {shown.map((d) => (
              <li>
                <DogCard dog={d} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      adopted.length > 0 && (
        <section class="mt-20" aria-labelledby="ya-tienen-hogar">
          <h2 id="ya-tienen-hogar" class="text-2xl font-bold [font-variation-settings:'wght'_700]">
            Ya tienen hogar
          </h2>
          <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            {adopted.map((d) => (
              <li>
                <DogCard dog={d} asLink={false} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Site>
