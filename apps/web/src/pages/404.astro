---
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import Site from "../layouts/Site.astro";
Astro.response.status = 404;
---

<Site title="No encontramos esa página" description="La página que buscas no existe en MAYA Pets." noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <PawPrint weight="fill" size={64} className="text-teal-400" aria-hidden="true" />
    <h1 class="mt-6 text-4xl font-bold [font-variation-settings:'wght'_740]">Maya se llevó esta página</h1>
    <p class="mt-3 text-lg text-ink-soft">La buscamos por todo el patio y no aparece. Puede que el enlace haya cambiado.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/tienda" class="btn btn-sun">Ir a la tienda</a>
      <a href="/" class="btn btn-soft">Volver al inicio</a>
    </div>
  </section>
</Site>
