---
import { listProducts, productBySlug } from "@maya/api";
import { CaretRight } from "@phosphor-icons/react/dist/ssr/CaretRight";
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { WhatsappLogo } from "@phosphor-icons/react/dist/ssr/WhatsappLogo";
import { ProductCard } from "../../components/shared/ProductCard";
import AddToCart from "../../islands/site/AddToCart";
import Site from "../../layouts/Site.astro";
import { formatCOP, SPECIES_LABEL, whatsappLink } from "../../lib/format";
import { envOf } from "../../lib/server";

const { DB } = envOf(Astro);
const product = await productBySlug(DB, Astro.params.slug!);
if (!product) {
  return Astro.rewrite("/404");
}

const related = (
  await listProducts(DB, { categoria: product.category.slug, orden: "destacados", pagina: 1 })
).items
  .filter((p) => p.id !== product.id)
  .slice(0, 4);

const cover = product.images[0] ?? null;
const minPrice = Math.min(...product.variants.map((v) => v.price));
const inStock = product.variants.some((v) => v.stock > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  brand: product.brand ? { "@type": "Brand", name: product.brand } : undefined,
  image: product.images.map((i) => new URL(i.url, Astro.site).toString()),
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "COP",
    lowPrice: minPrice,
    highPrice: Math.max(...product.variants.map((v) => v.price)),
    availability: inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
  },
};
---

<Site
  title={`${product.name}${product.brand ? ` ${product.brand}` : ""}`}
  description={`${product.name} desde ${formatCOP(minPrice)}. ${product.description.slice(0, 120)}`}
  image={cover?.url}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-[1280px] px-4 pt-6 sm:px-6">
    <nav aria-label="Ruta" class="text-sm text-ink-soft">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/tienda" class="hover:underline">Tienda</a></li>
        <li aria-hidden="true"><CaretRight size={14} /></li>
        <li><a href={`/tienda?categoria=${product.category.slug}`} class="hover:underline">{product.category.name}</a></li>
        <li aria-hidden="true"><CaretRight size={14} /></li>
        <li aria-current="page" class="text-ink">{product.name}</li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-8 md:grid-cols-2 lg:gap-14">
      <div>
        <div data-product-image class="toy aspect-square overflow-hidden bg-teal-50">
          {
            cover ? (
              <img src={cover.url} alt={cover.alt} width={cover.width ?? 900} height={cover.height ?? 900} class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
            ) : (
              <div class="flex h-full flex-col items-center justify-center gap-3 text-teal-600">
                <PawPrint weight="fill" size={84} aria-hidden="true" />
                <span class="font-medium text-ink-soft">La foto llega pronto</span>
              </div>
            )
          }
        </div>
        {
          product.images.length > 1 && (
            <ul class="mt-3 grid grid-cols-4 gap-3" aria-label="Más fotos">
              {product.images.slice(1, 5).map((img) => (
                <li class="aspect-square overflow-hidden rounded-2xl bg-teal-50">
                  <img src={img.url} alt={img.alt} class="h-full w-full object-cover" loading="lazy" width="200" height="200" />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="md:pt-2">
        <p class="text-ink-soft">{product.brand ? `${product.brand} · ` : ""}{SPECIES_LABEL[product.species]}</p>
        <h1 class="mt-1 text-3xl font-bold leading-tight [font-variation-settings:'wght'_720] sm:text-4xl">{product.name}</h1>

        <div class="mt-6">
          <AddToCart
            client:load
            slug={product.slug}
            name={product.name}
            variantLabel={product.variantLabel}
            variants={product.variants}
            imageUrl={cover?.url ?? null}
          />
        </div>

        {
          product.description && (
            <div class="mt-10 border-t border-line pt-6">
              <h2 class="text-lg font-semibold">Sobre este producto</h2>
              <p class="mt-2 max-w-[62ch] whitespace-pre-line text-ink-soft">{product.description}</p>
            </div>
          )
        }

        <a
          href={whatsappLink(`Hola MAYA Pets, tengo una pregunta sobre: ${product.name}`)}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-teal-700 hover:underline"
        >
          <WhatsappLogo weight="fill" size={20} aria-hidden="true" />
          ¿Dudas con la talla o el peso? Pregúntanos
        </a>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-20" aria-labelledby="relacionados">
          <h2 id="relacionados" class="text-2xl font-bold [font-variation-settings:'wght'_700]">
            También en {product.category.name.toLowerCase()}
          </h2>
          <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4">
            {related.map((p) => (
              <li>
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Site>
