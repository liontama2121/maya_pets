---
import { hasRole, loadContent } from "@maya/api";
import SeasonsManager, { type AdminSeason } from "../../islands/admin/SeasonsManager";
import Admin from "../../layouts/Admin.astro";
import { adminFetch } from "../../lib/admin-server";
import { envOf } from "../../lib/server";

if (!hasRole(Astro.locals.staff!)) return Astro.redirect("/admin");
const [seasons, content] = await Promise.all([adminFetch<AdminSeason[]>(Astro, "/seasons"), loadContent(envOf(Astro).DB)]);
const { banner } = content;
---

<Admin title="Temporadas">
  <h1 class="text-3xl font-bold [font-variation-settings:'wght'_720]">Temporadas</h1>
  <p class="mt-1 max-w-2xl text-ink-soft">
    Elige las fechas y la tienda se viste sola: colores, decoración y el tono del banner del inicio.
  </p>
  <div class="mt-6">
    <SeasonsManager
      client:load
      initial={seasons}
      banner={{ title: banner.title, subtitle: banner.subtitle, ctaLabel: banner.ctaLabel, href: banner.ctaHref, image: banner.image }}
    />
  </div>
</Admin>
