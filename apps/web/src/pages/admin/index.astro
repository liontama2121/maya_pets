---
import { hasRole, liveSeason } from "@maya/api";
import { Plus } from "@phosphor-icons/react/dist/ssr/Plus";
import { Warning } from "@phosphor-icons/react/dist/ssr/Warning";
import Admin from "../../layouts/Admin.astro";
import { envOf } from "../../lib/server";

const { DB } = envOf(Astro);
const staff = Astro.locals.staff!;

const [low, counts, season] = await Promise.all([
  DB.prepare(
    `SELECT v.id, v.name AS variant, v.stock, v.min_stock, p.id AS product_id, p.name AS product
     FROM product_variants v JOIN products p ON p.id = v.product_id
     WHERE v.active = 1 AND p.active = 1 AND v.stock <= v.min_stock
     ORDER BY v.stock ASC, p.name LIMIT 12`,
  ).all<{ id: number; variant: string; stock: number; min_stock: number; product_id: number; product: string }>(),
  DB.prepare(
    `SELECT (SELECT COUNT(*) FROM products WHERE active = 1) AS products,
            (SELECT COUNT(*) FROM categories WHERE active = 1) AS categories,
            (SELECT COUNT(*) FROM product_variants v JOIN products p ON p.id = v.product_id
               WHERE v.active = 1 AND p.active = 1 AND v.stock = 0) AS sold_out`,
  ).first<{ products: number; categories: number; sold_out: number }>(),
  liveSeason(DB),
]);

const hour = Number(new Intl.DateTimeFormat("es-CO", { hour: "numeric", hour12: false, timeZone: "America/Bogota" }).format(new Date()));
const greeting = hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";
const firstName = staff.name.split(" ")[0];
const isAdmin = hasRole(staff);
---

<Admin title="Resumen">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold [font-variation-settings:'wght'_720]">{greeting}, {firstName}</h1>
      <p class="mt-1 text-ink-soft">Así va la tienda hoy.</p>
    </div>
    {isAdmin && <a href="/admin/productos/nuevo" class="btn btn-sun"><Plus size={20} weight="bold" aria-hidden="true" /> Nuevo producto</a>}
  </div>

  <dl class="mt-8 grid grid-cols-3 gap-3 sm:max-w-2xl">
    <div class="rounded-[var(--radius-toy)] bg-white p-4">
      <dt class="text-sm text-ink-soft">Productos activos</dt>
      <dd class="tnum mt-1 text-3xl font-bold text-teal-900">{counts?.products ?? 0}</dd>
    </div>
    <div class="rounded-[var(--radius-toy)] bg-white p-4">
      <dt class="text-sm text-ink-soft">Categorías</dt>
      <dd class="tnum mt-1 text-3xl font-bold text-teal-900">{counts?.categories ?? 0}</dd>
    </div>
    <div class="rounded-[var(--radius-toy)] bg-white p-4">
      <dt class="text-sm text-ink-soft">Agotados</dt>
      <dd class:list={["tnum mt-1 text-3xl font-bold", counts?.sold_out ? "text-danger" : "text-teal-900"]}>{counts?.sold_out ?? 0}</dd>
    </div>
  </dl>

  <div class="mt-8 grid gap-6 xl:grid-cols-[1.4fr_1fr]">
    <section class="rounded-[var(--radius-toy)] bg-white p-5 sm:p-6" aria-labelledby="stock-bajo">
      <h2 id="stock-bajo" class="flex items-center gap-2 text-xl font-semibold">
        <Warning size={22} weight="fill" className="text-danger" aria-hidden="true" /> Por reponer
      </h2>
      {
        low.results.length === 0 ? (
          <p class="mt-3 text-ink-soft">Todo tiene stock por encima del mínimo. Bien ahí.</p>
        ) : (
          <ul class="mt-4 divide-y divide-line">
            {low.results.map((r) => (
              <li>
                <a href={`/admin/productos/${r.product_id}`} class="flex min-h-14 items-center justify-between gap-4 rounded-xl px-2 hover:bg-teal-50">
                  <span>
                    <span class="font-medium">{r.product}</span>
                    <span class="text-ink-soft"> · {r.variant}</span>
                  </span>
                  <span class:list={["tnum shrink-0 rounded-full px-3 py-1 text-sm font-semibold", r.stock === 0 ? "bg-danger-soft text-danger" : "bg-sun-100 text-teal-900"]}>
                    {r.stock === 0 ? "Agotado" : `${r.stock} de mín. ${r.min_stock}`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="rounded-[var(--radius-toy)] bg-white p-5 sm:p-6" aria-labelledby="temporada">
      <h2 id="temporada" class="text-xl font-semibold">Temporada en la tienda</h2>
      {
        season ? (
          <>
            <p class="mt-3">
              <span class="font-semibold">{season.preset.name}</span> está activa hasta el{" "}
              {new Date(`${season.event.endsAt}T12:00:00`).toLocaleDateString("es-CO", { day: "numeric", month: "long" })}.
            </p>
            <p class="mt-1 text-ink-soft">“{season.event.headline}”</p>
          </>
        ) : (
          <p class="mt-3 text-ink-soft">Ninguna activa. La tienda se ve con sus colores de siempre.</p>
        )
      }
      {isAdmin && <a href="/admin/temporadas" class="btn btn-soft btn-sm mt-5">Administrar temporadas</a>}
    </section>
  </div>
</Admin>
