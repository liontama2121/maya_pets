---
import { hasRole } from "@maya/api";
import { MagnifyingGlass } from "@phosphor-icons/react/dist/ssr/MagnifyingGlass";
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { Plus } from "@phosphor-icons/react/dist/ssr/Plus";
import { Star } from "@phosphor-icons/react/dist/ssr/Star";
import Admin from "../../../layouts/Admin.astro";
import { adminFetch } from "../../../lib/admin-server";
import { formatCOP } from "../../../lib/format";

const staff = Astro.locals.staff!;
if (!hasRole(staff, "vendedor")) return Astro.redirect("/admin");
const isAdmin = hasRole(staff);

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const estado = Astro.url.searchParams.get("estado") ?? "activos";
const categoria = Astro.url.searchParams.get("categoria") ?? "";
const qs = new URLSearchParams({ estado });
if (q) qs.set("q", q);
if (categoria) qs.set("categoria", categoria);

type Row = {
  id: number;
  name: string;
  brand: string;
  active: boolean;
  featured: boolean;
  categoryName: string;
  priceFrom: number | null;
  priceTo: number | null;
  stock: number;
  variantCount: number;
  lowVariants: number;
  imageUrl: string | null;
};
const [products, categories] = await Promise.all([
  adminFetch<Row[]>(Astro, `/products?${qs}`),
  adminFetch<{ id: number; name: string }[]>(Astro, "/categories"),
]);

const estados = [
  ["activos", "Visibles"],
  ["stock-bajo", "Por reponer"],
  ["archivados", "Ocultos"],
  ["todos", "Todos"],
] as const;
---

<Admin title="Productos">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="text-3xl font-bold [font-variation-settings:'wght'_720]">Productos</h1>
    {
      isAdmin && (
        <a href="/admin/productos/nuevo" class="btn btn-sun">
          <Plus size={20} weight="bold" aria-hidden="true" /> Nuevo producto
        </a>
      )
    }
  </div>

  <form method="get" class="mt-6 flex flex-wrap items-end gap-3" role="search">
    <div class="relative min-w-[240px] flex-1 sm:max-w-sm">
      <label for="q" class="sr-only">Buscar por nombre, marca o código</label>
      <MagnifyingGlass size={20} className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-soft" aria-hidden="true" />
      <input id="q" name="q" type="search" value={q} class="field !rounded-full pl-11" placeholder="Nombre, marca o código de barras" />
    </div>
    <div>
      <label for="categoria" class="sr-only">Categoría</label>
      <select id="categoria" name="categoria" class="field !rounded-full">
        <option value="">Todas las categorías</option>
        {categories.map((c) => <option value={c.id} selected={String(c.id) === categoria}>{c.name}</option>)}
      </select>
    </div>
    <input type="hidden" name="estado" value={estado} />
    <button class="btn btn-teal btn-sm">Buscar</button>
  </form>

  <nav aria-label="Filtrar por estado" class="mt-4 flex flex-wrap gap-2">
    {
      estados.map(([value, label]) => {
        const p = new URLSearchParams(qs);
        p.set("estado", value);
        return (
          <a href={`?${p}`} class="chip !min-h-10 text-sm" aria-current={estado === value ? "page" : undefined}>
            {label}
          </a>
        );
      })
    }
  </nav>

  {
    products.length === 0 ? (
      <div class="mt-8 flex flex-col items-center rounded-[var(--radius-toy)] bg-white px-6 py-14 text-center">
        <PawPrint weight="fill" size={48} className="text-teal-400" aria-hidden="true" />
        <p class="mt-3 text-lg font-semibold">{q ? "Nada coincide con esa búsqueda." : "Aún no hay productos aquí."}</p>
        {isAdmin && !q && (
          <a href="/admin/productos/nuevo" class="btn btn-sun mt-5">
            Crear el primero
          </a>
        )}
      </div>
    ) : (
      <ul class="mt-6 overflow-hidden rounded-[var(--radius-toy)] bg-white" aria-label={`${products.length} productos`}>
        {products.map((p) => (
          <li class="border-b border-line last:border-0">
            <a
              href={`/admin/productos/${p.id}`}
              class="grid grid-cols-[56px_1fr_auto] items-center gap-4 px-4 py-3 hover:bg-teal-50 sm:grid-cols-[56px_1.6fr_1fr_1fr_auto]"
            >
              <span class="size-14 overflow-hidden rounded-xl bg-teal-50">
                {p.imageUrl ? (
                  <img src={p.imageUrl} alt="" class="h-full w-full object-cover" loading="lazy" width="56" height="56" />
                ) : (
                  <span class="grid h-full place-items-center text-teal-400">
                    <PawPrint weight="fill" size={22} />
                  </span>
                )}
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-1.5 font-medium">
                  {p.featured && <Star size={16} weight="fill" className="shrink-0 text-sun-500" aria-label="Destacado" />}
                  <span class="truncate">{p.name}</span>
                </span>
                <span class="block truncate text-sm text-ink-soft">
                  {p.categoryName}
                  {p.brand ? ` · ${p.brand}` : ""}
                  {!p.active ? " · Oculto" : ""}
                </span>
              </span>
              <span class="tnum hidden sm:block">
                {p.priceFrom == null
                  ? "Sin precio"
                  : p.priceFrom === p.priceTo
                    ? formatCOP(p.priceFrom)
                    : `${formatCOP(p.priceFrom)} a ${formatCOP(p.priceTo!)}`}
              </span>
              <span class="hidden text-sm text-ink-soft sm:block">
                {p.variantCount} {p.variantCount === 1 ? "presentación" : "presentaciones"}
              </span>
              <span
                class:list={[
                  "tnum rounded-full px-3 py-1 text-sm font-semibold",
                  p.stock === 0 ? "bg-danger-soft text-danger" : p.lowVariants > 0 ? "bg-sun-100 text-teal-900" : "bg-teal-50 text-teal-900",
                ]}
              >
                {p.stock === 0 ? "Agotado" : `${p.stock} und.`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Admin>
