---
import { loadContent, paragraphs } from "@maya/api";
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { WhatsappLogo } from "@phosphor-icons/react/dist/ssr/WhatsappLogo";
import Site from "../layouts/Site.astro";
import { CONTACT_WHATSAPP, whatsappLink } from "../lib/format";
import { envOf } from "../lib/server";

// Textos editables en "Contenido del sitio" → Página de Nosotros.
const content = await loadContent(envOf(Astro).DB, Astro.locals.contentDraft);
const { nosotros } = content;
---

<Site
  title="La historia de Maya"
  description="MAYA Pets nació de una perrita imaginaria. Conoce la historia de la tienda para perros y gatos en Bogotá."
  content={content}
>
  <section class="on-field bg-[var(--field)] text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
      <PawPrint weight="fill" size={40} className="text-[var(--accent)]" aria-hidden="true" />
      <h1 class="mt-4 text-4xl font-bold leading-[1.05] [font-variation-settings:'wght'_760] [text-wrap:balance] sm:text-6xl">
        {nosotros.title}
      </h1>
    </div>
  </section>

  <article class="mx-auto max-w-2xl px-4 py-14 text-lg leading-relaxed sm:px-6">
    {
      paragraphs(nosotros.body).map((parts, i) => (
        <p class:list={[i > 0 && "mt-6"]}>{parts.map((s) => (s.bold ? <strong>{s.text}</strong> : s.text))}</p>
      ))
    }

    <div class="rope my-12" aria-hidden="true"></div>

    <h2 class="text-2xl font-bold [font-variation-settings:'wght'_700]">{nosotros.visitTitle}</h2>
    <p class="mt-3 text-ink-soft">{nosotros.visitText}</p>
    <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-teal mt-6">
      <WhatsappLogo weight="fill" size={22} aria-hidden="true" />
      {CONTACT_WHATSAPP.display}
    </a>
  </article>
</Site>
