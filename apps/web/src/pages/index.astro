---
import { bannerProducts, bestSellers, isBannerLive, listCategories, liveSeason, loadContent } from "@maya/api";
import { ArrowRight } from "@phosphor-icons/react/dist/ssr/ArrowRight";
import { PawPrint } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { ProductCard } from "../components/shared/ProductCard";
import { SeasonBanner } from "../components/shared/SeasonBanner";
import Site from "../layouts/Site.astro";
import { envOf } from "../lib/server";

/**
 * Inicio. Todos los textos e imágenes salen de "Contenido del sitio" (panel → /admin/contenido).
 * Con ?borrador=1 y sesión de editor se ven los borradores (vista previa).
 */
const { DB } = envOf(Astro);
const content = await loadContent(DB, Astro.locals.contentDraft);
const { hero, banner, especies, destacados } = content;
const bannerLive = Astro.locals.contentDraft ? banner.enabled : isBannerLive(banner);

const [season, featured, categories, bannerItems] = await Promise.all([
  liveSeason(DB),
  bestSellers(DB, destacados.pinnedIds, 8),
  listCategories(DB),
  bannerLive ? bannerProducts(DB, banner) : Promise.resolve([]),
]);
const dogCats = categories.filter((c) => c.species !== "gato");
const catCats = categories.filter((c) => c.species !== "perro");

// "Maya" del título va en el color de acento, donde aparezca.
const titleParts = hero.title.split(/(Maya)/);

const cards = [
  { key: "perro", data: especies.dog, href: "/tienda?especie=perro", cats: dogCats, tone: "bg-teal-100", tilt: "group-hover:-rotate-3" },
  { key: "gato", data: especies.cat, href: "/tienda?especie=gato", cats: catCats, tone: "bg-sun-100", tilt: "group-hover:rotate-3" },
] as const;
---

<Site
  title="MAYA Pets | Tienda para perros y gatos en Bogotá"
  description="Alimento, collares, correas, platos, snacks y premios para tu perro o gato en Bogotá."
  season={season}
  content={content}
>
  <!-- Hero: Maya saluda en primera persona. Es invisible: solo se ven su sombra y sus huellas, que siguen al cursor. -->
  <section class="on-field relative overflow-hidden bg-[var(--field)] text-white" data-hero aria-labelledby="hola">
    <div
      class="hero-grid relative z-10 mx-auto grid min-h-[min(680px,calc(100dvh-72px))] max-w-[1280px] grid-cols-2 items-end gap-x-2 px-4 pt-12 sm:px-6 md:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,600px)_minmax(0,1fr)] lg:gap-x-6"
    >
      <div class="[grid-area:text] self-center pb-6 text-center lg:pb-16">
        <h1
          id="hola"
          data-enter
          class="text-5xl font-bold leading-[1] tracking-[-0.02em] [font-variation-settings:'wght'_780] [text-wrap:balance] sm:text-6xl lg:text-7xl"
        >
          {titleParts.map((part) => (part === "Maya" ? <span class="text-[var(--accent)]">{part}</span> : part))}
        </h1>
        <p data-enter class="mx-auto mt-6 max-w-[46ch] text-lg leading-relaxed text-white/90 sm:text-xl">
          {hero.text}
        </p>
        <div data-enter class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
          <a href={hero.ctaHref} class="btn btn-sun text-lg">{hero.ctaLabel}</a>
          <a
            href={hero.storyHref}
            class="group inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-[var(--accent)] decoration-2 underline-offset-[6px] hover:decoration-4"
          >
            {hero.storyLabel}
            <ArrowRight weight="bold" size={18} className="transition-transform group-hover:translate-x-1" aria-hidden="true" />
          </a>
        </div>
        <!-- Donde Maya se sienta al cargar: debajo de lo que dice, con aire para que su globo no tape los enlaces. -->
        <div data-maya-home class="mx-auto mt-16 h-10 w-24" aria-hidden="true"></div>
      </div>

      {
        hero.imageLeft.src && (
          <figure data-enter class="hero-pet [grid-area:left] justify-self-start sm:justify-self-center lg:justify-self-end">
            <img src={hero.imageLeft.src} alt={hero.imageLeft.alt} width="400" height="480" fetchpriority="high" decoding="async" />
          </figure>
        )
      }
      {
        hero.imageRight.src && (
          <figure data-enter class="hero-pet hero-pet--right [grid-area:right] justify-self-end sm:justify-self-center lg:justify-self-start">
            <img src={hero.imageRight.src} alt={hero.imageRight.alt} width="400" height="480" decoding="async" />
          </figure>
        )
      }
    </div>

    <!-- Capa de Maya: decorativa, no bloquea clics -->
    <div class="pointer-events-none absolute inset-0 z-20" aria-hidden="true">
      <div data-maya-trail class="absolute inset-0 text-[var(--accent)]"></div>
      <div data-maya-body class="maya-body absolute left-0 top-0">
        <span data-maya-shadow class="maya-shadow"></span>
        <span class="maya-sit text-[var(--accent)]">
          <PawPrint weight="fill" size={26} />
          <PawPrint weight="fill" size={26} />
        </span>
        <span data-maya-bubble data-show="false" class="maya-bubble"></span>
      </div>
    </div>
  </section>

  <!-- ¿Quién te espera en casa? -->
  <section class="mx-auto max-w-[1280px] px-4 pt-16 sm:px-6 md:pt-24" aria-labelledby="especies">
    <h2 id="especies" class="max-w-xl scroll-mt-28 text-3xl font-bold [font-variation-settings:'wght'_700] sm:text-4xl">
      {especies.title}
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        cards.map(({ data, href, cats, tone, tilt }) => (
          <a href={href} class:list={["toy group relative flex min-h-[340px] flex-col overflow-hidden p-6 sm:p-8", tone]}>
            {data.image.src && (
              <img
                src={data.image.src}
                alt=""
                width="400"
                height="480"
                loading="lazy"
                decoding="async"
                class:list={[
                  // Celular y tableta: arriba a la derecha, junto al título. Escritorio: grande, sentado en el borde.
                  "pointer-events-none absolute right-3 top-4 h-36 w-auto transition-transform duration-500 ease-[var(--ease-squish)] group-hover:scale-105 sm:h-44 lg:top-auto lg:-bottom-3 lg:right-6 lg:h-[78%] lg:max-h-[300px]",
                  tilt,
                ]}
              />
            )}
            <div class="relative min-h-36 max-w-[56%] sm:min-h-44 sm:max-w-[60%] lg:min-h-0">
              <h3 class="text-4xl font-bold text-teal-900 [font-variation-settings:'wght'_720]">{data.title}</h3>
              <p class="mt-2 text-ink-soft">{data.text}</p>
            </div>
            <ul class="relative mt-6 flex flex-wrap gap-2 lg:max-w-[58%]" aria-label={`Categorías: ${data.title}`}>
              {cats.map((c) => (
                <li class="rounded-full bg-white/85 px-3 py-1.5 text-sm font-medium text-teal-900">{c.name}</li>
              ))}
            </ul>
            <span class="relative mt-auto inline-flex items-center gap-2 pt-6 font-semibold text-teal-900">
              {data.linkLabel}
              <ArrowRight weight="bold" size={18} className="transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    bannerLive && (
      <section id="temporada" class="mx-auto max-w-[1280px] scroll-mt-28 px-4 pt-16 sm:px-6 md:pt-24">
        <SeasonBanner
          preset={season?.preset ?? null}
          data={{
            title: banner.title,
            subtitle: banner.subtitle,
            ctaLabel: banner.ctaLabel,
            href: banner.ctaHref,
            image: banner.image,
          }}
        />
        {bannerItems.length > 0 && (
          <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4">
            {bannerItems.map((p) => (
              <li>
                <ProductCard product={p} showPrice={banner.showPrices} />
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  <!-- Lo que más se llevan: fijados + más vendidos 30 días + destacados -->
  <section class="pt-16 md:pt-24" aria-labelledby="destacados">
    <div class="mx-auto flex max-w-[1280px] items-end justify-between gap-4 px-4 sm:px-6">
      <h2 id="destacados" class="scroll-mt-28 text-3xl font-bold [font-variation-settings:'wght'_700] sm:text-4xl">
        {destacados.title}
      </h2>
      <a href="/tienda" class="hidden shrink-0 font-semibold text-teal-700 hover:underline sm:inline">Ver toda la tienda</a>
    </div>
    <ul
      class="mx-auto mt-8 flex max-w-[1280px] snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] sm:px-6 lg:grid lg:grid-cols-4 lg:gap-x-5 lg:gap-y-10 lg:overflow-visible"
    >
      {
        featured.map((p) => (
          <li class="w-[68%] shrink-0 snap-start sm:w-[42%] lg:w-auto">
            <ProductCard product={p} />
          </li>
        ))
      }
    </ul>
    <div class="mx-auto mt-2 max-w-[1280px] px-4 sm:hidden">
      <a href="/tienda" class="btn btn-soft w-full">Ver toda la tienda</a>
    </div>
  </section>
</Site>

<style>
  /* Móvil: texto arriba, perrito y gatico abajo. Escritorio: los dos enmarcan el texto. */
  .hero-grid {
    grid-template-areas:
      "text text"
      "left right";
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-areas: "left text right";
    }
  }
  .hero-pet {
    margin: 0;
    width: min(100%, 190px);
  }
  .hero-pet img {
    display: block;
    width: 100%;
    height: auto;
    /* Se apoyan en el borde inferior del hero, como sentados en el piso. */
    margin-bottom: -6px;
    filter: drop-shadow(0 18px 18px rgb(3 28 29 / 0.35));
  }
  @media (min-width: 640px) {
    .hero-pet {
      width: min(100%, 230px);
    }
  }
  @media (min-width: 1024px) {
    .hero-pet {
      width: min(100%, 320px);
    }
    .hero-pet img {
      transform: rotate(-3deg);
      transform-origin: 50% 100%;
    }
    .hero-pet--right img {
      transform: rotate(3deg);
    }
  }

  /* La sombra de un perro sentado: lo único visible de Maya. */
  .maya-body {
    width: 0;
    height: 0;
  }
  .maya-shadow {
    position: absolute;
    left: -64px;
    top: -14px;
    width: 128px;
    height: 28px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.28) 60%, transparent);
    filter: blur(2px);
  }
  .maya-sit {
    position: absolute;
    left: -34px;
    top: -18px;
    display: flex;
    gap: 16px;
    transition:
      opacity 220ms var(--ease-out-expo),
      transform 220ms var(--ease-out-expo);
  }
  .maya-body[data-walking="true"] .maya-sit {
    opacity: 0;
    transform: translateY(4px) scale(0.8);
  }
  .maya-bubble {
    position: absolute;
    left: -24px;
    bottom: 34px;
    width: max-content;
    max-width: min(240px, 60vw);
    padding: 10px 16px 12px;
    border-radius: 20px 20px 20px 6px;
    background: #fff;
    color: var(--color-teal-900);
    font-weight: 500;
    line-height: 1.3;
    box-shadow:
      inset 0 -3px 0 var(--color-teal-100),
      0 14px 24px -12px rgb(0 0 0 / 0.5);
    transform-origin: 12px 100%;
    transition:
      opacity 260ms var(--ease-out-expo),
      transform 320ms var(--ease-squish);
  }
  .maya-bubble[data-show="false"] {
    opacity: 0;
    transform: translateY(6px) scale(0.85);
  }
  :global(.maya-step) {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    opacity: 0;
  }
</style>

<script>
  import { heroEntrance, initMayaFollow } from "../motion/maya";
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const home = document.querySelector<HTMLElement>("[data-maya-home]");
  const body = document.querySelector<HTMLElement>("[data-maya-body]");
  const trail = document.querySelector<HTMLElement>("[data-maya-trail]");
  const bubble = document.querySelector<HTMLElement>("[data-maya-bubble]");
  if (hero) heroEntrance(hero);
  if (hero && home && body && trail && bubble) initMayaFollow({ zone: hero, home, body, trail, bubble });
</script>
